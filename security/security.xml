<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_stock_map_company" model="ir.rule">
        <field name="name">Warehouse Map: multi-company</field>
        <field name="model_id" ref="model_tricasia_stock_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_stock_map_shape_company" model="ir.rule">
        <field name="name">Warehouse Map Shape: multi-company</field>
        <field name="model_id" ref="model_tricasia_stock_map_shape"/>
        <field name="domain_force">[('map_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
